# === Required ===
JWT_SECRET="super strong"
DATABASE_URL=postgres://user:password@localhost:5433/notesdb

# === Server ===
PORT=3002
NODE_ENV=development
API_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY_HEADERS=false

# === Security ===
# JWT_EXPIRY_SECONDS=604800  # 7 days

# === Note limits ===
# MAX_TAGS_PER_NOTE=20
# MAX_TAG_LENGTH=100
# MAX_FOLDER_LENGTH=100

# === Uploads ===
# MAX_UPLOAD_FILE_MB=10
# MAX_IMPORT_FILE_MB=5
# ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp

# === DeepSeek (summarize / auto-tag / detect actions) ===
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TEMPERATURE=0.2
# DEEPSEEK_MAX_TOKENS=1024

# === Google AI (embeddings + Gemini Flash Lite for RAG) ===
GOOGLE_API_KEY=
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBED_MODEL=text-embedding-004
# GEMINI_EMBED_DIMENSIONS=768
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_TOKENS=1024

# === RAG knobs ===
# RAG_CHUNK_MAX_CHARS=3200
# RAG_RETRIEVE_TOP_K=20
# RAG_ANSWER_TOP_K=8
# RAG_RERANK_SNIPPET_CHARS=800
# AI_SUMMARY_MAX_INPUT_CHARS=8000
# AI_DETECT_ACTIONS_MAX_INPUT_CHARS=8000
